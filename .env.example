# Copier ce fichier en .env.local et renseigner les valeurs du projet Supabase à utiliser.
# Développement et préproduction : projet « elimu-dev ». Production : projet de production.
# Seule la clé publique « anon » doit se trouver ici. Ne jamais mettre la clé service_role.
VITE_SUPABASE_URL=https://<ref-du-projet>.supabase.co
VITE_SUPABASE_ANON_KEY=<cle-anon-publique>
